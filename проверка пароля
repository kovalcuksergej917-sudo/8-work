        "def validate_password() -> str:\n",
        "    \"\"\"Запрашивает и валидирует пароль (8-20 символов, ≥1 заглавная, ≥1 цифра).\"\"\"\n",
        "    while True:\n",
        "        pwd = input(\"Введите пароль: \")\n",
        "        errors = []\n",
        "\n",
        "        if len(pwd) < 8:\n",
        "            errors.append(\"Длина пароля должна быть не менее 8 символов.\")\n",
        "        elif len(pwd) > 20:\n",
        "            errors.append(\"Длина пароля не должна превышать 20 символов.\")\n",
        "\n",
        "        if not any(char.isupper() for char in pwd):\n",
        "            errors.append(\"Пароль должен содержать хотя бы одну заглавную букву.\")\n",
        "\n",
        "        if not any(char.isdigit() for char in pwd):\n",
        "            errors.append(\"Пароль должен содержать хотя бы одну цифру.\")\n",
        "\n",
        "        if not errors:\n",
        "            return pwd\n",
        "\n",
        "        print(\"Ошибка(и) в пароле:\")\n",
        "        for err in errors:\n",
        "            print(f\"  • {err}\")\n",
        "        print()\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    print(\"✅ Пароль успешно установлен!\")"
      ]
    }
  ]
