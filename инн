        "import re\n",
        "\n",
        "def validate_inn() -> str:\n",
        "    \"\"\"Запрашивает и валидирует ИНН физического лица (ровно 12 цифр).\"\"\"\n",
        "    while True:\n",
        "        inn = input(\"Введите ИНН (12 цифр): \").strip()\n",
        "        # fullmatch проверяет всю строку целиком, исключая лишние символы\n",
        "        if re.fullmatch(r'\\d{12}', inn):\n",
        "            return inn\n",
        "        print(\"Ошибка: ИНН должен состоять ровно из 12 цифр.\\n\")\n",
        "\n",
        "# Запуск для теста\n",
        "if __name__ == \"__main__\":\n",
        "    print(f\"✅ ИНН принят: {validate_inn()}\")"
      ]
    }
